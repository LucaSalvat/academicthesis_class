%%
%% academicthesis-kernel.sty
%% --------------------------------------------------------------
%% Shared LaTeX3 internals for the academicthesis ecosystem.
%%
%% This package is loaded by `academicthesis.cls` (the core class)
%% AND by every university plugin (`academicthesis-<uni>.sty`).
%% It must never be loaded directly by end users.
%%
%% It provides, in order:
%%   1. Namespacing / messages
%%   2. The metadata store (a property list + accessor functions)
%%   3. The l3keys interface behind \thesissetup
%%   4. List-valued metadata (supervisors, co-supervisors, examiners...)
%%   5. The plugin registries (front pages, requirements, bib defaults)
%%   6. The university loader
%%   7. The localisation ("string") store used by language files
%%
%% Naming convention: every internal control sequence lives in the
%% `academicthesis` / `__academicthesis` expl3 namespaces, e.g.
%%   \academicthesis_meta_set:nn      (public-ish, stable internal API)
%%   \__academicthesis_frontpage_dispatch:   (private)
%% University plugins talk to the kernel ONLY through the documented
%% \Declare... functions below -- never by poking at the prop/seq
%% variables directly. That is what keeps core and plugins decoupled.
%%--------------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}
\RequirePackage{expl3}
\RequirePackage{xparse}
\ProvidesExplPackage{academicthesis-kernel}{2026/01/01}{0.1.0}
  {Shared internals for the academicthesis class family}

\RequirePackage{l3keys2e}

\ExplSyntaxOn

% =====================================================================
% 1. Messages
% =====================================================================
% A single message module ("academicthesis") is shared by the core
% class and all plugins, so errors look uniform regardless of which
% file actually triggered them.

\msg_new:nnnn { academicthesis } { unknown-university }
  { Unknown~university~'#1'. }
  {
    No~package~academicthesis-#1~could~be~loaded.~Install~it,~or~check~
    for~a~typo~in~the~'university=#1'~class~option.
  }

\msg_new:nnnn { academicthesis } { missing-frontpage }
  { No~front~page~registered~for~university~'#1',~degree~'#2'. }
  {
    The~university~package~'academicthesis-#1'~does~not~provide~a~
    front~page~for~the~'#2'~degree~type.~Check~the~package~
    documentation~for~the~degree~types~it~supports.
  }

\msg_new:nnnn { academicthesis } { missing-metadata }
  { Missing~required~thesis~metadata:~'#1'. }
  { Define~it~in~the~preamble,~for~example:~\MessageBreak #2 }

\msg_new:nnnn { academicthesis } { invalid-key-value }
  { Invalid~value~'#2'~for~key~'#1'. }
  { #3 }

\msg_new:nnnn { academicthesis } { invalid-degree }
  { No~degree~type~selected~or~degree~type~'#1'~is~unknown. }
  {
    Pass~one~of~the~degree~options~declared~by~your~university~
    package~as~a~class~option,~e.g.~\MessageBreak
    \exp_not:n { \documentclass[university=luiss,bachelor]{academicthesis} }
  }


% =====================================================================
% 2. Metadata store
% =====================================================================
% All thesis metadata (title, candidate, degree...) lives in ONE
% global property list keyed by string, instead of dozens of ad-hoc
% \def\th@xxx{} pairs. This makes validation, iteration and plugin
% extension uniform and easy to reason about.

\prop_new:N \g__academicthesis_meta_prop

\cs_new_protected:Npn \academicthesis_meta_set:nn #1 #2
  { \prop_gput:Nnn \g__academicthesis_meta_prop { #1 } { #2 } }

% Expandable getter -- safe to use directly in document text.
\cs_new:Npn \academicthesis_meta_get:n #1
  {
    \prop_item:Nn \g__academicthesis_meta_prop { #1 }
  }

\prop_new:N \l__academicthesis_tmp_prop

\cs_new:Npn \academicthesis_meta_get:nF #1 #2
  {
    \prop_get:NnNTF \g__academicthesis_meta_prop { #1 } \l__academicthesis_tmp_tl
      { \tl_use:N \l__academicthesis_tmp_tl }
      { #2 }
  }
\tl_new:N \l__academicthesis_tmp_tl

\prop_new:N \g__academicthesis_meta_prop_aux % (placeholder kept for clarity)

% Expandable (p, T, F, TF): \prop_item:Nn is expandable, unlike
% \prop_get:NnNTF, which assigns and so cannot be used inside a predicate
% or \bool_if:n test. A missing key counts as empty.
\prg_new_conditional:Npnn \academicthesis_meta_if_empty:n #1 { p , T , F , TF }
  {
    \exp_args:Ne \tl_if_empty:nTF
      { \prop_item:Nn \g__academicthesis_meta_prop { #1 } }
      { \prg_return_true: } { \prg_return_false: }
  }

% Generic "required field" check, used both by the core (for the
% common fields) and by plugins (for university-specific fields).
%   #1 = metadata key       (e.g. {title})
%   #2 = example invocation shown in the error message
\cs_new_protected:Npn \academicthesis_require:nn #1 #2
  {
    \academicthesis_meta_if_empty:nTF { #1 }
      { \msg_error:nnnn { academicthesis } { missing-metadata } { #1 } { #2 } }
      { }
  }

% Conditional require: only check when a boolean is true.
%   #1 = \bool_if:NTF -style boolean variable
\cs_new_protected:Npn \academicthesis_require_if:Nnn #1 #2 #3
  {
    \bool_if:NT #1 { \academicthesis_require:nn {#2} {#3} }
  }


% =====================================================================
% 3. l3keys interface behind \thesissetup{...}
% =====================================================================
% Base (university-agnostic) keys. University plugins add their own
% keys in their OWN namespaces (see \DeclareThesisKey below) so that
% e.g. `major` from academicthesis-luiss can never collide with a key
% of the same name from academicthesis-bocconi.

\keys_define:nn { academicthesis / meta }
  {
    title        .code:n = { \academicthesis_meta_set:nn { title }        {#1} } ,
    subtitle     .code:n = { \academicthesis_meta_set:nn { subtitle }     {#1} } ,
    candidate    .code:n = { \academicthesis_meta_set:nn { candidate }    {#1} } ,
    degree       .code:n = { \academicthesis_meta_set:nn { degree }       {#1} } ,
    chair        .code:n = { \academicthesis_meta_set:nn { chair }        {#1} } ,
    department   .code:n = { \academicthesis_meta_set:nn { department }   {#1} } ,
    academicyear .code:n = { \academicthesis_meta_set:nn { academicyear } {#1} } ,
    idnumber     .code:n = { \academicthesis_meta_set:nn { idnumber }     {#1} } ,
    copyyear     .code:n = { \academicthesis_meta_set:nn { copyyear }     {#1} } ,
    examdate     .code:n = { \academicthesis_meta_set:nn { examdate }     {#1} } ,
    authoremail  .code:n = { \academicthesis_meta_set:nn { authoremail }  {#1} } ,
    website      .code:n = { \academicthesis_meta_set:nn { website }      {#1} } ,
    cycle        .code:n = { \academicthesis_meta_set:nn { cycle }        {#1} } ,
    phdtitle     .code:n = { \academicthesis_meta_set:nn { phdtitle }     {#1} } ,
    % text of the dedication page, for front pages that place it
    % themselves (e.g. Bocconi); \dedication{...} is unaffected
    dedication   .code:n = { \academicthesis_meta_set:nn { dedication }   {#1} } ,
    % for front pages that print the abstract themselves (e.g. PoliMi
    % article format); the abstractthesis environment is unaffected
    abstract     .code:n = { \academicthesis_meta_set:nn { abstract }     {#1} } ,
    keywords     .code:n = { \academicthesis_meta_set:nn { keywords }     {#1} } ,

    %  Booleans / enumerations -----------------------------------
    gender       .choice: ,
    gender / male   .code:n = { \bool_gset_false:N \g__academicthesis_female_bool } ,
    gender / female .code:n = { \bool_gset_true:N  \g__academicthesis_female_bool } ,
    gender / m      .code:n = { \bool_gset_false:N \g__academicthesis_female_bool } ,
    gender / f      .code:n = { \bool_gset_true:N  \g__academicthesis_female_bool } ,
    gender .groups:n = { female-aware } ,

    %  List-valued fields (see \S4) -------------------------------
    supervisor    .code:n = { \academicthesis_list_set:nn   { supervisors }   {#1} } ,
    supervisors   .code:n = { \academicthesis_list_set_csv:nn { supervisors } {#1} } ,
    cosupervisor  .code:n = { \academicthesis_list_set:nn   { cosupervisors } {#1} } ,
    cosupervisors .code:n = { \academicthesis_list_set_csv:nn { cosupervisors } {#1} } ,
    examiner      .code:n = { \academicthesis_list_set_csv:nn { examiners } {#1} } ,
    examiners     .code:n = { \academicthesis_list_set_csv:nn { examiners } {#1} } ,
    % PhD roles (e.g. PoliMi): tutor(s), and the coordinator / chair of
    % the doctoral programme
    tutor         .code:n = { \academicthesis_list_set:nn   { tutors } {#1} } ,
    tutors        .code:n = { \academicthesis_list_set_csv:nn { tutors } {#1} } ,
    coordinator  .code:n = { \academicthesis_meta_set:nn { coordinator }  {#1} } ,
  }

\bool_new:N \g__academicthesis_female_bool

% Degree-type booleans. The *standard* triad shipped by the kernel;
% plugins may test these in \DeclareThesisRequirement / \DeclareThesisFrontPage.
% (A university is, of course, free to only register front pages for
% the subset it actually offers.)
\bool_new:N \g__academicthesis_bachelor_bool
\bool_new:N \g__academicthesis_master_bool
\bool_new:N \g__academicthesis_phd_bool

\NewDocumentCommand \thesissetup { m }
  { \keys_set:nn { academicthesis / meta } { #1 } }

% Convenience "verb" commands kept for users who prefer the classic
% \thtitle{..}/\candidate{..} style instead of \thesissetup{title=..}.
% They are thin wrappers around the SAME key-value engine, so both
% styles always stay in sync.
\cs_new_protected:Npn \__academicthesis_def_setter:nn #1 #2
  {
    \exp_args:Nc \NewDocumentCommand { #2 } { m }
      { \keys_set:nn { academicthesis / meta } { #1 = ##1 } }
  }
\__academicthesis_def_setter:nn { title }        { thtitle }
\__academicthesis_def_setter:nn { subtitle }     { thsubtitle }
\__academicthesis_def_setter:nn { candidate }    { candidate }
\__academicthesis_def_setter:nn { degree }       { degree }
\__academicthesis_def_setter:nn { chair }        { chair }
\__academicthesis_def_setter:nn { department }   { department }
\__academicthesis_def_setter:nn { academicyear } { academicyear }
\__academicthesis_def_setter:nn { idnumber }     { idnumber }
\__academicthesis_def_setter:nn { copyyear }     { copyyear }
\__academicthesis_def_setter:nn { examdate }     { examdate }
\__academicthesis_def_setter:nn { authoremail }  { authoremail }
\__academicthesis_def_setter:nn { website }      { website }
\__academicthesis_def_setter:nn { cycle }        { cycle }
\__academicthesis_def_setter:nn { gender }       { gender }
\__academicthesis_def_setter:nn { supervisor }   { supervisor }
\__academicthesis_def_setter:nn { supervisors }  { supervisors }
\__academicthesis_def_setter:nn { cosupervisor }  { cosupervisor }
\__academicthesis_def_setter:nn { cosupervisors } { cosupervisors }
\__academicthesis_def_setter:nn { examiner }     { examiner }


% =====================================================================
% 4. List-valued metadata  (supervisors, co-supervisors, examiners...)
% =====================================================================
% Stored as expl3 sequences in a prop-of-seqs emulation: one global
% sequence per list name, created on first use.

\clist_new:N \g__academicthesis_listnames_clist

\cs_new_protected:Npn \__academicthesis_list_ensure:n #1
  {
    \clist_if_in:NnF \g__academicthesis_listnames_clist { #1 }
      {
        \clist_gput_right:Nn \g__academicthesis_listnames_clist { #1 }
        \seq_new:c { g__academicthesis_list_ #1 _seq }
      }
  }

\cs_new_protected:Npn \academicthesis_list_set:nn #1 #2
  {
    \__academicthesis_list_ensure:n { #1 }
    \seq_gclear:c { g__academicthesis_list_ #1 _seq }
    \seq_gput_right:cn { g__academicthesis_list_ #1 _seq } { #2 }
  }

\cs_new_protected:Npn \academicthesis_list_add:nn #1 #2
  {
    \__academicthesis_list_ensure:n { #1 }
    \seq_gput_right:cn { g__academicthesis_list_ #1 _seq } { #2 }
  }

% Comma-separated convenience setter, e.g. supervisors={A, B, C}
\cs_new_protected:Npn \academicthesis_list_set_csv:nn #1 #2
  {
    \__academicthesis_list_ensure:n { #1 }
    \seq_gclear:c { g__academicthesis_list_ #1 _seq }
    \clist_map_inline:nn { #2 }
      { \seq_gput_right:cn { g__academicthesis_list_ #1 _seq } { ##1 } }
  }

% Expandable: number of entries in a list (0 for a list never set)
\cs_new:Npn \academicthesis_list_count:n #1
  {
    \seq_if_exist:cTF { g__academicthesis_list_ #1 _seq }
      { \int_eval:n { \seq_count:c { g__academicthesis_list_ #1 _seq } } }
      { 0 }
  }

% Typeset a list with a given separator (default: line break)
\NewDocumentCommand \academicthesislist { O{\\} m }
  {
    \seq_if_exist:cT { g__academicthesis_list_ #2 _seq }
      { \seq_use:cn { g__academicthesis_list_ #2 _seq } { #1 } }
  }

\prg_new_conditional:Npnn \academicthesis_list_if_empty:n #1 { p , T , F , TF }
  {
    \int_compare:nNnTF { \academicthesis_list_count:n {#1} } = { 0 }
      { \prg_return_true: } { \prg_return_false: }
  }


% ---- Document-level accessors ----------------------------------------
% The same metadata, readable from ordinary LaTeX2e code (expl3 syntax
% OFF). University packages should write everything that TYPESETS text
% (title pages, heading formats, page styles) in normal syntax, where
% spaces and blank lines behave as usual, and read metadata through
% these commands -- see academicthesis-polimi-classical.def.
%   \thesismeta{title}                         expandable
%   \IfThesisMetaEmptyTF{subtitle}{<empty>}{<not empty>}
%   \IfThesisListEmptyTF{cosupervisors}{<empty>}{<not empty>}
%   \thesislistcount{supervisors}               expandable
%   \IfThesisDegreeTF{bachelor}{<yes>}{<no>}
\NewExpandableDocumentCommand \thesismeta { m }
  { \academicthesis_meta_get:n { #1 } }
\NewDocumentCommand \IfThesisMetaEmptyTF { m +m +m }
  { \academicthesis_meta_if_empty:nTF { #1 } { #2 } { #3 } }
\NewExpandableDocumentCommand \thesislistcount { m }
  { \academicthesis_list_count:n { #1 } }
\NewDocumentCommand \IfThesisListEmptyTF { m +m +m }
  { \academicthesis_list_if_empty:nTF { #1 } { #2 } { #3 } }
\NewDocumentCommand \IfThesisDegreeTF { m +m +m }
  { \str_if_eq:VnTF \g__academicthesis_degree_tl { #1 } { #2 } { #3 } }


% =====================================================================
% 5. Plugin registries
% =====================================================================
% University packages NEVER hard-code into the core. Instead they
% register callbacks for the slots the core knows how to dispatch:
%   * front pages          (per university + degree type)
%   * required metadata    (per university + degree type)
%   * bibliography defaults
% The core looks these up at the right time and errors helpfully
% when nothing is registered.

% Declared here (rather than in \S6) because the registries below
% reference them in code bodies that may run before \S6 is reached.
\tl_new:N \g__academicthesis_university_tl
\tl_new:N \g__academicthesis_degree_tl

\prop_new:N \g__academicthesis_frontpage_prop
\prop_new:N \g__academicthesis_bibdefaults_prop
\seq_new:N  \g__academicthesis_requirements_seq

% Variants taking a token-list *variable* (V) where the base expl3
% signatures only accept literal token lists (n) -- the lookup keys
% here are assembled at run time from \tl variables.
% \prop_get:NVNTF and \prop_if_in_p:NV ship with the kernel already;
% \prop_item:Nn only has a `c` variant built in, so add `NV` here.
\cs_generate_variant:Nn \prop_item:Nn   { NV }

% ---- Front pages ----------------------------------------------------
% \DeclareThesisFrontPage{<university>}{<degree>}{<control sequence>}
% <control sequence> is invoked with no arguments to typeset the title
% page (it should set up its own \begin{titlepage}...\end{titlepage}).
\NewDocumentCommand \DeclareThesisFrontPage { m m m }
  {
    \prop_gput:Nnn \g__academicthesis_frontpage_prop { #1 . #2 } { #3 }
  }

\tl_new:N \l__academicthesis_lookup_tl

\cs_new_protected:Npn \__academicthesis_frontpage_dispatch:
  {
    \tl_set:Nx \l__academicthesis_lookup_tl
      { \g__academicthesis_university_tl . \g__academicthesis_degree_tl }
    \prop_get:NVNTF \g__academicthesis_frontpage_prop \l__academicthesis_lookup_tl
    % (NV variant ships with l3kernel: prop name N, key as V-type tl)
      \l__academicthesis_tmp_tl
      { \tl_use:N \l__academicthesis_tmp_tl }
      {
        \msg_error:nnee { academicthesis } { missing-frontpage }
          { \g__academicthesis_university_tl } { \g__academicthesis_degree_tl }
      }
  }
% (the dispatcher is exposed publicly as \frontpage in the core class)


% ---- Per-university / per-degree metadata requirements -------------
% \DeclareThesisRequirement{<university>}{<degree-bool>}{<key>}{<example>}
% <degree-bool> is an expl3 boolean variable (e.g. \g__academicthesis_phd_bool)
% or \c_true_bool to require unconditionally for that university.
\NewDocumentCommand \DeclareThesisRequirement { m m m m }
  {
    \seq_gput_right:Nn \g__academicthesis_requirements_seq { { #1 } { #2 } { #3 } { #4 } }
  }

\cs_new_protected:Npn \__academicthesis_run_requirements:
  {
    \seq_map_inline:Nn \g__academicthesis_requirements_seq
      {
        \__academicthesis_run_requirement:nnnn ##1
      }
  }
\cs_new_protected:Npn \__academicthesis_run_requirement:nnnn #1#2#3#4
  {
    \tl_if_eq:NnTF \g__academicthesis_university_tl { #1 }
      {
        \academicthesis_require_if:Nnn #2 { #3 } { #4 }
      }
      { }
  }

% ---- Bibliography defaults ------------------------------------------
% \DeclareThesisBibDefaults{<university>}{<biblatex options, comma list>}
% Applied only if the user has not already requested biblatex options
% explicitly through the `biblatex-options` class/key interface.
\NewDocumentCommand \DeclareThesisBibDefaults { m m }
  {
    \prop_gput:Nnn \g__academicthesis_bibdefaults_prop { #1 } { #2 }
  }

\cs_new:Npn \__academicthesis_bibdefaults_get:
  {
    \prop_item:NV \g__academicthesis_bibdefaults_prop \g__academicthesis_university_tl
  }
\prg_new_conditional:Npnn \__academicthesis_if_bibdefaults: { p , T , F , TF }
  {
    \bool_if:nTF
      { \prop_if_in_p:NV \g__academicthesis_bibdefaults_prop \g__academicthesis_university_tl }
      { \prg_return_true: } { \prg_return_false: }
  }


% ---- Base class, formats, second page, extra languages -------------
% These four are declared from the university's early configuration
% file academicthesis-<uni>.cfg, which the class reads BEFORE
% \LoadClass (see \S6). They only ever concern the active university,
% so they take no <university> argument.
%
% \DeclareThesisBaseClass{<class>}{<default class options>}
%   The class the thesis is built on (book, article, ...) and the
%   options it gets by default. A default is dropped when the user
%   already chose an option of the same group (e.g. a user `11pt'
%   wins over a default `12pt', `oneside' over `twoside').
\tl_new:N    \g__academicthesis_baseclass_tl
\clist_new:N \g__academicthesis_baseclass_options_clist
\NewDocumentCommand \DeclareThesisBaseClass { m m }
  {
    \tl_gset:Nn    \g__academicthesis_baseclass_tl { #1 }
    \clist_gset:Nn \g__academicthesis_baseclass_options_clist { #2 }
  }

% \DeclareThesisFormats{<available formats>}{<default format>}
%   The values accepted by the `format=' class option. A university
%   that declares none accepts no `format=' at all.
\tl_new:N    \g__academicthesis_format_tl
\clist_new:N \g__academicthesis_formats_clist
\tl_new:N    \g__academicthesis_format_default_tl
\NewDocumentCommand \DeclareThesisFormats { m m }
  {
    \clist_gset:Nn \g__academicthesis_formats_clist { #1 }
    \tl_gset:Nn    \g__academicthesis_format_default_tl { #2 }
    % resolve now, so the rest of the .cfg can branch on the format
    \academicthesis_resolve_format:
  }

\msg_new:nnnn { academicthesis } { no-formats }
  { University~'#1'~does~not~offer~formats~(format=#2~ignored). }
  { Remove~the~'format'~class~option. }
\msg_new:nnnn { academicthesis } { unknown-format }
  { Unknown~format~'#2'~for~university~'#1'. }
  { Available~formats:~#3. }

\cs_new_protected:Npn \academicthesis_resolve_format:
  {
    \tl_if_empty:NTF \g__academicthesis_format_tl
      { \tl_gset_eq:NN \g__academicthesis_format_tl \g__academicthesis_format_default_tl }
      {
        \clist_if_empty:NTF \g__academicthesis_formats_clist
          {
            \msg_error:nnee { academicthesis } { no-formats }
              { \g__academicthesis_university_tl } { \g__academicthesis_format_tl }
            \tl_gclear:N \g__academicthesis_format_tl
          }
          {
            \clist_if_in:NVF \g__academicthesis_formats_clist \g__academicthesis_format_tl
              {
                \msg_error:nneee { academicthesis } { unknown-format }
                  { \g__academicthesis_university_tl } { \g__academicthesis_format_tl }
                  { \clist_use:Nn \g__academicthesis_formats_clist { ,~ } }
                \tl_gset_eq:NN \g__academicthesis_format_tl \g__academicthesis_format_default_tl
              }
          }
      }
  }

% \DeclareThesisSecondPage{true|false}
%   Whether \frontpage is followed by the second page (examination
%   commission + copyright). Default true. The user can always override
%   it with the `secondpage' / `no-secondpage' class options.
\bool_new:N \g__academicthesis_secondpage_default_bool
\bool_gset_true:N \g__academicthesis_secondpage_default_bool
\NewDocumentCommand \DeclareThesisSecondPage { m }
  { \bool_gset:Nn \g__academicthesis_secondpage_default_bool { \use:c { c_ #1 _bool } } }

% \DeclareThesisClassOption{<name>}{<default>}
%   Claims a \documentclass option for the university, e.g.
%   \DeclareThesisClassOption{simil_frontpages}{false}. Its value is what
%   the user typed (`name' alone means `true'), else <default>; it is not
%   passed on to the base class. Read it with
%   \academicthesis_class_option:n{<name>} (expandable) or, in normal
%   syntax, \thesisclassoption{<name>}.
\prop_new:N  \g__academicthesis_extra_options_prop     % every unknown option
\prop_new:N  \g__academicthesis_class_options_prop     % claimed ones, resolved
\clist_new:N \g__academicthesis_claimed_options_clist
\NewDocumentCommand \DeclareThesisClassOption { m m }
  {
    \clist_gput_right:Nn \g__academicthesis_claimed_options_clist { #1 }
    \prop_get:NnNTF \g__academicthesis_extra_options_prop { #1 } \l__academicthesis_tmp_tl
      {
        \tl_if_blank:VT \l__academicthesis_tmp_tl
          { \tl_set:Nn \l__academicthesis_tmp_tl { true } }
        \prop_gput:NnV \g__academicthesis_class_options_prop { #1 } \l__academicthesis_tmp_tl
      }
      { \prop_gput:Nnn \g__academicthesis_class_options_prop { #1 } { #2 } }
  }
\cs_new:Npn \academicthesis_class_option:n #1
  { \prop_item:Nn \g__academicthesis_class_options_prop { #1 } }
\NewExpandableDocumentCommand \thesisclassoption { m }
  { \academicthesis_class_option:n { #1 } }

% \DeclareThesisCoreRequirements{true|false}
%   Whether the core checks its own required fields (title, candidate,
%   academicyear, degree, supervisors). Default true. The university's
%   own \DeclareThesisRequirement entries are checked either way.
\bool_new:N \g__academicthesis_core_requirements_bool
\bool_gset_true:N \g__academicthesis_core_requirements_bool
\NewDocumentCommand \DeclareThesisCoreRequirements { m }
  { \bool_gset:Nn \g__academicthesis_core_requirements_bool { \use:c { c_ #1 _bool } } }

% \DeclareThesisOtherLanguages{<languages>}
%   Extra languages to load with babel/polyglossia besides the main one
%   (e.g. PoliMi always needs Italian for its Italian abstract).
\clist_new:N \g__academicthesis_otherlanguages_clist
\NewDocumentCommand \DeclareThesisOtherLanguages { m }
  { \clist_gput_right:Nn \g__academicthesis_otherlanguages_clist { #1 } }


% =====================================================================
% 6. University loader
% =====================================================================
% Resolves the `university=<id>` class option into a package load,
% with a clear error if the plugin is missing -- this is the seam
% that makes the family genuinely modular: the core ships with ZERO
% built-in knowledge of LUISS, Bocconi, LUMSA, etc.

% NOTE: \RequirePackage is safe to call here while \ExplSyntaxOn is in
% effect -- this is the same pattern other expl3-based packages use
% (e.g. acro.sty calls \RequirePackage{translations} from inside its own
% \ExplSyntaxOn block and never restores the standard regime). Toggling
% \ExplSyntaxOff/\ExplSyntaxOn around the load is unnecessary and was
% found, empirically, to corrupt expl3's internal state-tracking and
% hang a later \ExplSyntaxOn call -- so we deliberately do not do that.
% Early configuration: academicthesis-<uni>.cfg is read by the class
% BEFORE \LoadClass, so it may only use the \Declare... commands of
% \S5 (base class, formats, second page, other languages) and plain
% expl3 logic. It is read with expl3 syntax ON (spaces are ignored).
% A missing file is not an error here: if the package is missing too,
% \academicthesis_load_university:n reports the unknown university.
\msg_new:nnnn { academicthesis } { missing-config }
  { University~package~'#1'~has~no~academicthesis-#1.cfg. }
  {
    Every~university~ships~academicthesis-<uni>.cfg~declaring~at~least~
    its~base~class,~e.g.~\exp_not:N \DeclareThesisBaseClass{book}{}.~
    Using~'book'.
  }
\cs_new_protected:Npn \academicthesis_load_university_config:n #1
  {
    \file_if_exist:nTF { academicthesis-#1.cfg }
      { \file_input:n { academicthesis-#1.cfg } }
      {
        \file_if_exist:nT { academicthesis-#1.sty }
          { \msg_error:nnn { academicthesis } { missing-config } { #1 } }
      }
    \tl_if_empty:NT \g__academicthesis_baseclass_tl
      { \tl_gset:Nn \g__academicthesis_baseclass_tl { book } }
  }

\cs_new_protected:Npn \academicthesis_load_university:n #1
  {
    % NOTE: do NOT \tl_gset:Nn \g__academicthesis_university_tl {#1} here --
    % the class calls this as
    %   \academicthesis_load_university:n { \g__academicthesis_university_tl }
    % so #1 is that very csname (an unexpanded `n`-type token, not its
    % expanded value). Globally setting the variable to contain itself
    % creates a self-referential token list: the very next line has to
    % fully expand "academicthesis-#1.sty" for \IfFileExists, which then
    % expands \g__academicthesis_university_tl into itself forever --
    % an infinite expansion loop. The variable is already populated by
    % \keys_define:nn's `university .tl_set:N = \g__academicthesis_university_tl`
    % during class-option processing, so no re-assignment is needed here.
    \IfFileExists { academicthesis-#1.sty }
      { \RequirePackage { academicthesis-#1 } }
      { \msg_error:nnn { academicthesis } { unknown-university } { #1 } }
  }


% =====================================================================
% 7. Localisation ("string") store
% =====================================================================
% Language files populate one property list PER LANGUAGE with plain
% text via \ProvideThesisString{key}{text}. For each language the
% kernel reads, in order:
%   academicthesis-<lang>.ldf          generic strings (core keys)
%   academicthesis-<uni>-<lang>.ldf    optional university overrides
% The university file uses the SAME keys as the generic one
% (SupervisorLabel, IDNumber, ...) to change their wording, and may
% add its own keys for concepts only it knows.
%
% \thesisstring{key} reads the language currently selected for
% strings (the main language, unless a block such as
% \begin{abstractthesis}[language=italian] switched it), then the
% main language, then falls back to the key name, so a missing
% translation never produces a hard error mid-document.

\tl_new:N  \g__academicthesis_main_language_tl
\tl_new:N  \g__academicthesis_strings_loading_tl   % language being read
\tl_new:N  \l__academicthesis_strings_lang_tl      % language being used
\seq_new:N \g__academicthesis_loaded_languages_seq

\cs_generate_variant:Nn \prop_get:NnNTF { c }
\cs_generate_variant:Nn \prop_get:NnN   { c }
\cs_generate_variant:Nn \prop_if_in:NnTF { c }
\cs_generate_variant:Nn \prop_item:Nn   { c }

\NewDocumentCommand \ProvideThesisString { m m }
  {
    \prop_gput:cnn
      { g__academicthesis_strings_ \g__academicthesis_strings_loading_tl _prop }
      { #1 } { #2 }
  }

% Copy the raw (unexpanded) text of a string into a token list,
% e.g. to write it to the table of contents.
\cs_new_protected:Npn \academicthesis_string_get:nN #1 #2
  {
    \prop_get:cnNF
      { g__academicthesis_strings_ \l__academicthesis_strings_lang_tl _prop }
      { #1 } #2
      {
        \prop_get:cnNF
          { g__academicthesis_strings_ \g__academicthesis_main_language_tl _prop }
          { #1 } #2
          { \tl_set:Nx #2 { \tl_to_str:n { #1 } } }
      }
  }

% Expandable lookup (no fallback to the key name); used for PDF strings.
\cs_new:Npn \academicthesis_string:n #1
  {
    \prop_if_in:cnTF
      { g__academicthesis_strings_ \l__academicthesis_strings_lang_tl _prop } { #1 }
      { \prop_item:cn { g__academicthesis_strings_ \l__academicthesis_strings_lang_tl _prop } { #1 } }
      { \prop_item:cn { g__academicthesis_strings_ \g__academicthesis_main_language_tl _prop } { #1 } }
  }
% hyperref bookmarks: a heading such as \chapter*{\thesisstring{..}}
% becomes the string's text instead of a warning and an empty title.
\AtBeginDocument
  {
    \cs_if_exist:NT \pdfstringdefDisableCommands
      { \pdfstringdefDisableCommands { \cs_set_eq:NN \thesisstring \academicthesis_string:n } }
  }

\NewDocumentCommand \thesisstring { m }
  {
    \academicthesis_string_get:nN { #1 } \l__academicthesis_tmp_tl
    \tl_use:N \l__academicthesis_tmp_tl
  }

\msg_new:nnn { academicthesis } { missing-language }
  {
    No~academicthesis-#1.ldf~language~file~found;~falling~back~to~English.
  }

% .ldf files are plain data (\ProvideThesisString calls); they are
% \input, not \RequirePackage'd -- this is the same convention babel
% uses for its own *.ldf language definition files.
% Same note as \academicthesis_load_university:n above -- \input is
% safe to call here without toggling \ExplSyntaxOff/\ExplSyntaxOn.
% Each language is read once; asking again is a no-op.
\cs_new_protected:Npn \academicthesis_load_language:n #1
  { \__academicthesis_load_language:e { #1 } }
\cs_new_protected:Npn \__academicthesis_load_language:n #1
  {
    \seq_if_in:NnF \g__academicthesis_loaded_languages_seq { #1 }
      {
        \seq_gput_right:Nn \g__academicthesis_loaded_languages_seq { #1 }
        \prop_new:c { g__academicthesis_strings_ #1 _prop }
        \tl_gset:Nn \g__academicthesis_strings_loading_tl { #1 }
        \IfFileExists { academicthesis-#1.ldf }
          { \__academicthesis_input_ldf:n { academicthesis-#1.ldf } }
          {
            \msg_warning:nnn { academicthesis } { missing-language } { #1 }
            \__academicthesis_input_ldf:n { academicthesis-english.ldf }
          }
        \__academicthesis_load_university_language:en
          { \g__academicthesis_university_tl } { #1 }
      }
  }
\cs_generate_variant:Nn \__academicthesis_load_language:n { e }
\cs_new_protected:Npn \__academicthesis_load_university_language:nn #1 #2
  {
    \tl_if_empty:nF { #1 }
      {
        \IfFileExists { academicthesis-#1-#2.ldf }
          { \__academicthesis_input_ldf:n { academicthesis-#1-#2.ldf } }
          { }
      }
  }
\cs_generate_variant:Nn \__academicthesis_load_university_language:nn { e }

% Make <lang> the main language for strings (called once by the class).
\cs_new_protected:Npn \academicthesis_set_main_language:n #1
  {
    \academicthesis_load_language:n { #1 }
    \tl_gset:Ne \g__academicthesis_main_language_tl { #1 }
    \tl_set:Ne  \l__academicthesis_strings_lang_tl  { #1 }
  }

% Switch strings (and babel/polyglossia, when that language was loaded
% with the `other-languages' class option) to <lang> until the end of
% the current group. Used by \begin{abstractthesis}[language=...].
\cs_new_protected:Npn \academicthesis_select_language:n #1
  { \__academicthesis_select_language:e { #1 } }
\cs_new_protected:Npn \__academicthesis_select_language:n #1
  {
    \academicthesis_load_language:n { #1 }
    \tl_set:Nn \l__academicthesis_strings_lang_tl { #1 }
    \str_if_eq:VnF \g__academicthesis_main_language_tl { #1 }
      {
        \cs_if_exist:cTF { captions #1 }
          { \cs_if_exist:NT \otherlanguage { \otherlanguage { #1 } } }
          { \msg_warning:nnn { academicthesis } { language-not-loaded } { #1 } }
      }
  }
\msg_new:nnn { academicthesis } { language-not-loaded }
  {
    '#1'~is~used~with~language=#1~but~was~not~loaded~by~babel/polyglossia:~
    its~headings~are~translated~but~hyphenation~is~not.~Add~
    other-languages=#1~to~the~class~options.
  }
\cs_generate_variant:Nn \__academicthesis_select_language:n { e }

% The .ldf strings must be read with ordinary document catcodes: read
% under \ExplSyntaxOn every space in them is dropped ("Course of" ->
% "Courseof"). The strings are stored globally, so a group is enough.
\cs_new_protected:Npn \__academicthesis_input_ldf:n #1
  {
    \group_begin:
      \cctab_select:N \c_document_cctab
      \input { #1 }
    \group_end:
  }

\ExplSyntaxOff
\endinput
