%%
%% academicthesis-bocconi-frontpages.def
%% --------------------------------------------------------------
%% Bocconi opening pages, bachelor and master (one file: the two differ
%% only in small details of the simil front page).
%%
%% Read by academicthesis-bocconi.sty with NORMAL LaTeX syntax (expl3 off).
%%
%% simil_frontpages=false (default):
%%   page 1-2  blank (the university adds the official front page here)
%%   page 3    dedication page: \thesissetup{dedication={...}}, or blank
%%   page 4    blank (back of the dedication page)
%%   then the thesis, as for LUISS
%%
%% simil_frontpages=true:
%%   page 1    the printed (simil) front page, as the official one
%%   page 2    blank (its back)
%%   page 3-4  dedication page and its blank back, as above
%%   (no second page with commission / copyright in either case)
%%--------------------------------------------------------------
\ProvidesFile{academicthesis-bocconi-frontpages.def}[2026/10/19 v0.1.0 Bocconi opening pages]
\makeatletter

\newcommand\bocconi@emptypage{%
  \null
  \thispagestyle{empty}%
  \newpage}

% Always present: the dedication, or an empty page, then its blank back
\newcommand\bocconi@dedicationpage{%
  \thispagestyle{empty}%
  \IfThesisMetaEmptyTF{dedication}
    {\null}
    {\null\vspace{\stretch{0.26}}%
     \begin{flushright}\textit{\thesismeta{dedication}}\end{flushright}%
     \vspace{\stretch{0.74}}\null}%
  \newpage
  \bocconi@emptypage}

% ---------------------------------------------------------------------
% The simil front page (simil_frontpages=true), after the official one:
%
%   [vertical "Bocconi"]  Corso di Laurea Triennale / Bachelor of Science
%                         in <degree>
%                         <major>
%
%                         <title>
%
%                         Relatore / Advisor:
%                         <supervisors>
%
%                         Tesi di Laurea Triennale di /
%                         Bachelor of Science thesis by:
%                         <candidate>
%                         Matricola n. / student ID no <idnumber>
%
%                         Anno Accademico / Academic Year <academicyear>
%   [Universita Bocconi Milano logo]
%
% Master: "Laurea Magistrale / Master of Science" in the two lines that
% name the degree; everything else is the same.
% ---------------------------------------------------------------------

% A graphic if the file exists (pdf or png), else the stand-in
\newcommand\bocconi@graphic[3]{% #1 file, #2 includegraphics options, #3 stand-in
  \IfFileExists{#1.pdf}{\includegraphics[#2]{#1}}
    {\IfFileExists{#1.png}{\includegraphics[#2]{#1}}{#3}}}

% The two logos, placed on the page (eso-pic: origin at the bottom left;
% positions measured on the official page, A4)
\newcommand\bocconi@pagelogos{%
  \put(\LenToUnit{2.0cm},\LenToUnit{\dimexpr\paperheight-9.27cm\relax}){%
    \bocconi@graphic{\bocconi@wordmarkfile}{height=6.6cm}
      {\resizebox*{!}{6.6cm}{\rotatebox{90}{\rmfamily\bfseries Bocconi}}}}%
  \put(\LenToUnit{2.0cm},\LenToUnit{\dimexpr\paperheight-24.75cm\relax}){%
    \bocconi@graphic{\bocconi@logofile}{width=4.3cm}
      {\parbox[b]{4.3cm}{\sffamily
         {\large\bfseries Universit\`a\\Bocconi\par}
         \vspace{2pt}{\small MILANO\par}}}}}

\newcommand\bocconi@degreecourse{%
  \IfThesisDegreeTF{master}
    {\thesisstring{BocconiMasterCourse}}
    {\thesisstring{BocconiBachelorCourse}}}
\newcommand\bocconi@thesisby{%
  \IfThesisDegreeTF{master}
    {\thesisstring{BocconiMasterThesisBy}}
    {\thesisstring{BocconiBachelorThesisBy}}}

% Sizes and gaps, measured on the official page
\newcommand\bocconi@coursefont{\fontsize{12}{17}\selectfont} % programme lines
\newcommand\bocconi@titlefont{\fontsize{17}{20}\selectfont}  % title
\newcommand\bocconi@bodyfont{\fontsize{15}{30}\selectfont}   % names block

\newcommand\bocconi@similfrontpage{%
  \newgeometry{left=4.3cm, right=4.1cm, top=2.8cm, bottom=3cm}%
  \thispagestyle{empty}%
  \AddToShipoutPicture*{\bocconi@pagelogos}%
  \begingroup
  \sffamily\raggedright
  \setlength{\parskip}{0pt}%
  \parbox[t]{8cm}{\raggedright\bocconi@coursefont
    \bocconi@degreecourse\ \thesismeta{degree}\par
    \IfThesisMetaEmptyTF{major}{}{\thesismeta{major}\par}}\par
  \vspace{\bocconi@gapA}%
  {\bocconi@titlefont \thesismeta{title}\par}
  \IfThesisMetaEmptyTF{subtitle}{}
    {\vspace{4pt}{\bocconi@coursefont \thesismeta{subtitle}\par}}
  \vspace{\bocconi@gapB}%
  \bocconi@bodyfont
  \supervisorlabel:\par
  \academicthesislist[, ]{supervisors}\par
  \IfThesisListEmptyTF{cosupervisors}{}
    {\cosupervisorlabel:\par
     \academicthesislist[, ]{cosupervisors}\par}
  \vspace{\baselineskip}%
  \bocconi@thesisby\par
  \thesismeta{candidate}\par
  \thesisstring{IDNumber} \thesismeta{idnumber}\par
  \vspace{\bocconi@gapC}%
  \thesisstring{AcademicYear} \thesismeta{academicyear}\par
  \endgroup
  \restoregeometry}
\newcommand\bocconi@gapA{2.09cm}
\newcommand\bocconi@gapB{2.13cm}
\newcommand\bocconi@gapC{2.48cm}

\newcommand\bocconi@frontpage{%
  % letters for these pages, so their numbers never clash with the
  % front matter's (\frontmatter switches to roman numerals)
  \pagenumbering{Alph}%
  \ifbocconi@simil
    \bocconi@similfrontpage
    \bocconi@emptypage % its blank back
  \else
    \bocconi@emptypage
    \bocconi@emptypage
  \fi
  \bocconi@dedicationpage}

\DeclareThesisFrontPage{bocconi}{bachelor}{\bocconi@frontpage}
\DeclareThesisFrontPage{bocconi}{master}{\bocconi@frontpage}

\makeatother
\endinput
