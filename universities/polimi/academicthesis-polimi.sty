%%
%% academicthesis-polimi.sty
%% --------------------------------------------------------------
%% Politecnico di Milano plugin for the academicthesis class family,
%% modelled on the official templates of the School of Industrial and
%% Information Engineering (Scuola 3I), October 2021 revision.
%%
%%   \documentclass[university=polimi, master, format=classical]{academicthesis}
%%
%% Files:
%%   academicthesis-polimi.cfg            base class + formats (read before \LoadClass)
%%   academicthesis-polimi.sty            this file: options, metadata, registration
%%   academicthesis-polimi-classical.def  the classical layout (normal LaTeX syntax)
%%   academicthesis-polimi-article.def    the article layout (normal LaTeX syntax)
%%   academicthesis-polimi-summary.def    the executive summary layout
%%   academicthesis-polimi-phd.def        the PhD dissertation layout
%%   academicthesis-polimi-<lang>.ldf     PoliMi wording of the core strings
%%   logopolimi3i.pdf, raggierapolimi.pdf, logopolimiseal.png
%%
%% Metadata uses the core names unchanged (title, candidate, idnumber,
%% degree, supervisors, cosupervisors, academicyear). PoliMi's own
%% wording ("Advisor", "Student ID", ...) only changes the printed
%% strings, in academicthesis-polimi-<lang>.ldf.
%%--------------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}
\RequirePackage{expl3}
\RequirePackage{xparse}
\ProvidesExplPackage{academicthesis-polimi}{2026/10/10}{0.1.0}
  {Politecnico di Milano layouts for the academicthesis class}

\RequirePackage{academicthesis-kernel}

% =====================================================================
% 1. Layout controller:  \polimithesissetup{ logo-file=..., watermark=... }
% =====================================================================
\tl_new:N \l__polimi_logo_file_tl
\str_if_eq:VnTF \g__academicthesis_format_tl { phd }
  { \tl_set:Nn \l__polimi_logo_file_tl { logopolimiseal } } % round seal
  { \tl_set:Nn \l__polimi_logo_file_tl { logopolimi3i } }   % Scuola 3I
\newif \ifpolimi@watermark
\polimi@watermarktrue

\keys_define:nn { academicthesis-polimi / layout }
  {
    logo-file .tl_set:N = \l__polimi_logo_file_tl ,
    watermark .choices:nn = { true , false }
      { \use:c { polimi@watermark \l_keys_choice_tl } } ,
    watermark .default:n = { true } ,
    % page size of the PhD format (17x24cm as in the template, or A4)
    paper .choices:nn = { 17x24 , a4 }
      { \cs_if_exist_use:c { polimi@paper@ \l_keys_choice_tl } } ,
  }
\NewDocumentCommand \polimithesissetup { m }
  { \keys_set:nn { academicthesis-polimi / layout } { #1 } }

% Read by the layout files (normal syntax)
\cs_new:Npn \polimi@logofile { \l__polimi_logo_file_tl }


% =====================================================================
% 2. Required metadata (on top of the core's title, candidate, degree,
%    academicyear, supervisors): the student ID for classical and article
%    (the executive summary does not show it); department, doctoral
%    programme and cycle for the PhD cover
% =====================================================================
\str_case:VnF \g__academicthesis_format_tl
  {
    { summary } { }
    { phd }
      {
        % the PhD cover: department, doctoral programme, cycle
        \DeclareThesisRequirement { polimi } { \c_true_bool } { department }
          { \thesissetup{department={Department~of~...}} }
        \DeclareThesisRequirement { polimi } { \c_true_bool } { phdtitle }
          { \thesissetup{phdtitle={Doctoral~Program~in~...}} }
        \DeclareThesisRequirement { polimi } { \c_true_bool } { cycle }
          { \thesissetup{cycle=XXXVIII} }
      }
  }
  {
    \DeclareThesisRequirement { polimi } { \c_true_bool } { idnumber }
      { \thesissetup{idnumber=000000} }
  }


% =====================================================================
% 3. The layout of the selected format
% =====================================================================
% Packages first, from here: a package loaded from inside the .def file
% would switch expl3 syntax back on when it ends (see below).
\str_case:Vn \g__academicthesis_format_tl
  {
    { classical }
      {
        \RequirePackage { titlesec }    % chapter / section headings
        \RequirePackage { caption }     % coloured caption labels
        \RequirePackage { setspace }    % 1.5 line spacing
        \RequirePackage { eso-pic }     % background "raggiera"
        \RequirePackage { transparent } % ... at 40% opacity
        \RequirePackage { amsthm }      % coloured theorem heads
      }
    { article }
      {
        \RequirePackage { titlesec }    % section headings
        \RequirePackage { caption }     % coloured caption labels
        \RequirePackage { eso-pic }     % background "raggiera"
        \RequirePackage { transparent } % ... at 40% opacity
        \RequirePackage { amsthm }      % coloured theorem heads
        \RequirePackage { tcolorbox }   % keywords box
        % the cover prints the abstract, so it is required metadata
        \DeclareThesisRequirement { polimi } { \c_true_bool } { abstract }
          { \thesissetup{abstract={...},~keywords={...}} }
      }
    { summary }
      {
        \RequirePackage { titlesec }    % section headings
        \RequirePackage { caption }     % coloured caption labels
        \RequirePackage { eso-pic }     % background "raggiera"
        \RequirePackage { transparent } % ... at 40% opacity
        \RequirePackage { amsthm }      % coloured theorem heads
        \RequirePackage { tcolorbox }   % blue page header
      }
    { phd }
      {
        \RequirePackage { times }       % Times / Helvetica / Courier
        \RequirePackage { caption }     % caption style
        \RequirePackage { amsthm }      % definition environment
        \RequirePackage [ Sonny ] { fncychap }     % chapter headings
        \RequirePackage [ calcwidth ] { titlesec } % ruled sections
        \RequirePackage [ titles ] { tocloft }     % contents fonts
      }
  }

% ---------------------------------------------------------------------
% =====================================================================
% Layout code typesets text, so it lives in a .def file read with the
% normal document catcodes: under \ExplSyntaxOn spaces are dropped and
% blank lines do not end paragraphs (the problem met in the LUISS
% package). \cctab_begin:N switches catcodes WITHOUT a group, so the
% definitions in the file stay visible. The .def must not load
% packages (\RequirePackage would end with expl3 syntax back on).
\cs_new_protected:Npn \__polimi_input_layout:n #1
  {
    \cctab_begin:N \c_document_cctab
      \file_input:n { academicthesis-polimi-#1.def }
    \cctab_end:
  }
\exp_args:NV \__polimi_input_layout:n \g__academicthesis_format_tl

\ExplSyntaxOff
\endinput
