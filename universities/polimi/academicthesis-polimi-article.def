%%
%% academicthesis-polimi-article.def
%% --------------------------------------------------------------
%% PoliMi "article" thesis layout (article, 11pt, A4), after the
%% official Scuola 3I template (Thesis_article_format: config.tex +
%% title_page.tex).
%%
%% Read by academicthesis-polimi.sty with NORMAL LaTeX syntax (expl3
%% off). Metadata is read with the kernel's document-level accessors
%% (\thesismeta, \IfThesisMetaEmptyTF, \IfThesisListEmptyTF,
%% \IfThesisDegreeTF). No package may be loaded from here: the ones this
%% layout needs are loaded by the .sty.
%%
%% Differences from the classical format, as in the template:
%%   * no separate cover page: \frontpage prints a header block at the
%%     top of page 1 (logo, title, programme, author + ID, a column with
%%     advisor / co-advisors / academic year next to the abstract, and
%%     the keywords in a blue box), and the text starts right after it;
%%   * the English abstract and its keywords are METADATA:
%%       \thesissetup{abstract={...}, keywords={...}}
%%     further abstracts (e.g. Italian) use the abstractthesis
%%     environment, which here gives a section with the keywords box;
%%   * sections instead of chapters, page number centred in the footer.
%%--------------------------------------------------------------
\ProvidesFile{academicthesis-polimi-article.def}[2026/10/18 v0.1.0 PoliMi article layout]
\makeatletter

% =====================================================================
% 1. Colour, page, paragraphs
% =====================================================================
\definecolor{bluepoli}{cmyk}{0.4,0.1,0,0.4}
\colorlet{bluePoli}{bluepoli} % the name used by the official template

\geometry{a4paper, top=2.0cm, bottom=2.0cm, left=2.0cm, right=2.0cm}

\setlength{\parindent}{0pt}
\raggedbottom

\renewcommand{\LettrineFontHook}{\color{bluepoli}}

% =====================================================================
% 2. Captions and theorems
% =====================================================================
\captionsetup{labelfont={color=bluepoli}}

\newtheoremstyle{polimi}
  {\topsep}{\topsep}
  {\normalfont\itshape}{}
  {\color{bluepoli}\normalfont\bfseries}{.}
  { }{}
\theoremstyle{polimi}
\newtheorem{theorem}{\thesisstring{TheoremLabel}}[section]
\newtheorem{proposition}{\thesisstring{PropositionLabel}}[section]

% =====================================================================
% 3. Headings:  "1. Section title"
% =====================================================================
\titleformat{\section}
  {\color{bluepoli}\normalfont\Large\bfseries}
  {\color{bluepoli}\thesection.}{1em}{}
\titlespacing*{\section}{0pt}{3.3ex}{3.3ex}
\titleformat{\subsection}
  {\color{bluepoli}\normalfont\large\bfseries}
  {\color{bluepoli}\thesubsection.}{1em}{}
\titlespacing*{\subsection}{0pt}{3.3ex}{3.3ex}

% =====================================================================
% 4. Keywords: white text on a bluepoli!60 box
% =====================================================================
% Used by the cover and, through the core hook \thesiskeywords, by every
% \begin{abstractthesis}[keywords=...].
\newcommand\polimi@keywordsbox[2]{%
  \begin{tcolorbox}[arc=0pt, boxrule=0pt, colback=bluepoli!60,
                    width=\textwidth, colupper=white]
    \textbf{#1:} #2
  \end{tcolorbox}}

% =====================================================================
% 5. Watermark ("raggiera") at the top right of page 1
% =====================================================================
\newcommand\polimi@watermarkarticle{%
  \put(237,365){%
    \parbox[b][\paperheight]{\paperwidth}{%
      \vfill
      \centering
      \transparent{0.4}%
      \includegraphics[width=0.44\paperwidth]{raggierapolimi}%
      \vfill}}}

% =====================================================================
% 6. Front page: header block at the top of page 1 (bachelor and master)
% =====================================================================
\newcommand\polimi@thesistype{%
  \IfThesisDegreeTF{bachelor}
    {\thesisstring{BachelorThesisIn}}
    {\thesisstring{MasterThesisIn}}}

% one name per line, for the narrow left column
\newcommand\polimi@namelist[1]{\academicthesislist[\\]{#1}}

\newcommand\polimi@frontpage{%
  \ifpolimi@watermark\AddToShipoutPicture*{\polimi@watermarkarticle}\fi
  \noindent
  \includegraphics[trim={1.2cm 0 0 0}, clip, width=0.6\textwidth]{\polimi@logofile}
  \par\vspace{2mm}
  {\Large\bfseries\color{bluepoli}\thesismeta{title}\par}
  \IfThesisMetaEmptyTF{subtitle}{}
    {{\large\color{bluepoli}\thesismeta{subtitle}\par}}
  \vspace{2mm}
  % (Latin Modern has no bold small caps: medium small caps)
  {\fontsize{0.3cm}{0.5cm}\selectfont\color{bluepoli}%
    \textsc{\polimi@thesistype\\ \thesismeta{degree}}\par}
  \vspace{2mm}
  {\large\bfseries\thesismeta{candidate}, \thesismeta{idnumber}\par}
  \vspace{11pt}
  \noindent\rule{\textwidth}{0.4pt}\par
  \begin{center}
    \small
    \begin{minipage}[t]{.24\textwidth}
      \begin{minipage}{.90\textwidth}
        \scriptsize\raggedright
        \textbf{\supervisorlabel:}\\
        \polimi@namelist{supervisors}\\[\baselineskip]
        \IfThesisListEmptyTF{cosupervisors}{}
          {\textbf{\cosupervisorlabel:}\\
           \polimi@namelist{cosupervisors}\\[\baselineskip]}
        \textbf{\thesisstring{AcademicYear}:}\\
        \thesismeta{academicyear}
      \end{minipage}
    \end{minipage}%
    \begin{minipage}{.74\textwidth}
      \noindent\textbf{\color{bluepoli}\thesisstring{CoverAbstractLabel}:}
      \thesismeta{abstract}
    \end{minipage}
  \end{center}
  \vspace{15pt}
  \IfThesisMetaEmptyTF{keywords}{}
    {\polimi@keywordsbox{\thesisstring{KeywordsLabel}}{\thesismeta{keywords}}}
  \vspace{12pt}
  \normalsize}

\DeclareThesisFrontPage{polimi}{bachelor}{\polimi@frontpage}
\DeclareThesisFrontPage{polimi}{master}{\polimi@frontpage}

% =====================================================================
% 7. Core pieces redefined for PoliMi article
% =====================================================================
\AddToHook{class/academicthesis/after}{%
  % Page number centred in the footer, no header, no rules
  \fancypagestyle{Thesis}{%
    \fancyhf{}%
    \fancyfoot[C]{\thepage}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}}%
  \fancypagestyle{plain}{%
    \fancyhf{}%
    \fancyfoot[C]{\thepage}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}}%
  \AtBeginDocument{\pagestyle{Thesis}}%
  % Keywords after an abstract: the blue box
  \RenewDocumentCommand\thesiskeywords{m m}{%
    \par\vspace{15pt}\polimi@keywordsbox{#1}{#2}}%
  % Acknowledgements: a plain unnumbered section, upright
  \RenewDocumentCommand\thesisacknowledgementsbegin{m}{\section*{#1}}%
  \RenewDocumentCommand\thesisacknowledgementsend{}{\par}%
}

\makeatother
\endinput
