%%
%% academicthesis-luiss.sty
%% --------------------------------------------------------------
%% LUISS University plugin for the academicthesis class family.
%%
%% This package is a worked example of the plugin contract described
%% in doc/ARCHITECTURE.md: it knows NOTHING about other universities,
%% and the core class (academicthesis.cls) knows NOTHING about LUISS.
%% The two communicate exclusively through the registries exposed by
%% academicthesis-kernel.sty:
%%
%%   \DeclareThesisFrontPage  {luiss}{bachelor}{cs}   (in -bachelor-master.def)
%%   \DeclareThesisFrontPage  {luiss}{master}{cs}     (in -bachelor-master.def)
%%   \DeclareThesisFrontPage  {luiss}{phd}{cs}        (in -phd.def)
%%   \DeclareThesisRequirement{luiss}{<degree-bool>}{<key>}{<example>}
%%   \DeclareThesisBibDefaults{luiss}{<biblatex options>}
%%
%% Everything else here (colours, the `luiss={...}` key interface,
%% block layout) is private to this package and may change between
%% versions without affecting the core or other university plugins.
%%--------------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}[2023-06-01]
\ProvidesExplPackage{academicthesis-luiss}{2026/10/20}{0.2.0}
  {LUISS University front matter for the academicthesis class}

\RequirePackage{academicthesis-kernel}

% =====================================================================
% 1. Metadata
% =====================================================================
% The major and the PhD programme are the core's `major' and `phdtitle'
% keys (\thesissetup{major=..., phdtitle=...}, or \major{...}); they are
% also accepted by \luissthesissetup below.


% =====================================================================
% 2. Layout controller:  \luissthesissetup{ logo-align=..., ... }
% =====================================================================
\tl_new:N \l__luiss_logo_width_tl    \tl_set:Nn \l__luiss_logo_width_tl    { 0.55\textwidth }
\tl_new:N \l__luiss_logo_file_tl     \tl_set:Nn \l__luiss_logo_file_tl     { logoluissblue }
\dim_new:N \l__luiss_contentwidth_dim
\dim_set:Nn \l__luiss_contentwidth_dim { 0.9\textwidth }

\keys_define:nn { academicthesis-luiss / layout }
  {
    % --- Content keys (the core's metadata) ----------------------------
    major    .code:n = { \academicthesis_meta_set:nn { major }    {#1} } ,
    phdtitle .code:n = { \academicthesis_meta_set:nn { phdtitle } {#1} } ,

    % --- Logo file path (override default "logoluissblue") ------------
    logo-file  .tl_set:N = \l__luiss_logo_file_tl ,
    logo-width .tl_set:N = \l__luiss_logo_width_tl ,
  }

% Alignment keys: <block>-align = left | center | right (or l | c | r),
% stored as l, c or r (the first letter) in \l__luiss_<block>_align_tl.
% (department-align places the department line of the PhD page.)
\clist_map_inline:nn { logo , title , course , major , department }
  {
    \tl_new:c { l__luiss_ #1 _align_tl }
    \tl_set:cn { l__luiss_ #1 _align_tl } { l }
    \keys_define:nn { academicthesis-luiss / layout }
      {
        #1-align .choices:nn = { left , center , right , l , c , r }
          { \tl_set:cx { l__luiss_ #1 _align_tl } { \tl_head:N \l_keys_choice_tl } } ,
      }
  }

\NewDocumentCommand \luissthesissetup { m }
  { \keys_set:nn { academicthesis-luiss / layout } { #1 } }
% Backwards-compatible alias for the name used in the original class
\let\LuissThesisController\luissthesissetup

% Font sizes of the front page
\cs_new_protected:Npn \TitleFont    { \fontsize{16}{20}\selectfont }
\cs_new_protected:Npn \SubtitleFont { \fontsize{14}{18}\selectfont }
\cs_new_protected:Npn \LowerFont    { \fontsize{12}{14.5}\selectfont }


% =====================================================================
% 3. Building blocks (logo, title, name columns, ...)
% =====================================================================
\cs_new_protected:Npn \__luiss_aligned:nn #1 #2
  { \makebox[\linewidth][#2]{#1} }

\cs_new_protected:Npn \__luiss_alignedpar:nn #1 #2
  {
    \makebox[\textwidth][#2]{%
      \begin{minipage}{\l__luiss_contentwidth_dim}%
        \str_case_e:nn {#2} { {l}{\raggedright} {c}{\centering} {r}{\raggedleft} }%
        #1%
      \end{minipage}%
    }
  }

\cs_new_protected:Npn \__luiss_namecolumn:nn #1 #2
  {
    \parbox[t]{0.31\textwidth}{%
      \centering
      \setlength{\parskip}{4pt}%
      \textbf{#1}\par
      \nointerlineskip
      \rule{0.31\textwidth}{0.2pt}\par
      \nointerlineskip
      #2%
    }%
  }

% ---- Logo -----------------------------------------------------------
% Default logo file: "logoluissblue" (no extension; graphicx tries .pdf,
% .eps, etc.).  Found via kpathsea when installed in a texmf tree; for
% local compilation copy the logo next to your .tex file, add its
% directory to TEXINPUTS, or override: \luissthesissetup{logo-file=path}.
\cs_new_protected:Npn \__luiss_logobox:
  {
    \noindent
    \__luiss_aligned:nn
      { \includegraphics[width=\l__luiss_logo_width_tl]{\l__luiss_logo_file_tl} }
      { \l__luiss_logo_align_tl }
  }

% ---- Title block -----------------------------------------------------
\definecolor{BlueLuiss}{RGB}{21,57,108}
\renewcommand{\LettrineFontHook}{\color{BlueLuiss}}

\cs_new_protected:Npn \__luiss_title_formatted:n #1
  { {\TitleFont\bfseries\textcolor{BlueLuiss}{#1}\normalfont} }
\cs_new_protected:Npn \__luiss_subtitle_formatted:n #1
  { {\SubtitleFont #1 \normalfont} }

\cs_new_protected:Npn \__luiss_titleblock:
  {
    \noindent
    \__luiss_alignedpar:nn
      {
        \__luiss_title_formatted:n { \academicthesis_meta_get:n{title} }
        \par\vspace{0.02\textwidth}
        \academicthesis_meta_if_empty:nF {subtitle}
          { \__luiss_subtitle_formatted:n { \academicthesis_meta_get:n{subtitle} } }
      }
      { \l__luiss_title_align_tl }
  }

% ---- Programme block: "course + chair" or "PhD + cycle" ---------------
% One block, two uses -- only the text differs:
%   bachelor / master:  Course of <degree>  [major]  ...  Chair of <chair>
%   PhD:                PhD in <phdtitle>            ...  Cycle <cycle>
%   #1 first line, #2 optional middle line (code, may be empty),
%   #3 second line (after a small gap)
\cs_new_protected:Npn \__luiss_programme_block:nnn #1 #2 #3
  {
    \noindent
    \__luiss_alignedpar:nn
      {
        \LowerFont
        #1 \par
        #2
        \vspace*{0.02\textheight}
        #3
      }
      { \l__luiss_course_align_tl }
  }

% The major, when given, as the middle line (bachelor / master)
\cs_new_protected:Npn \__luiss_major_line:
  {
    \academicthesis_meta_if_empty:nF {major}
      { \__luiss_aligned:nn { \academicthesis_meta_get:n{major} } { \l__luiss_major_align_tl } \par }
  }

% ---- Department line under the logo (PhD) -----------------------------
\cs_new_protected:Npn \__luiss_department_line:
  {
    \noindent
    \__luiss_alignedpar:nn
      { \LowerFont \thesisstring{DepartmentOf}~\academicthesis_meta_get:n{department} }
      { \l__luiss_department_align_tl }
  }

% ---- Names block (author / supervisor[s] / co-supervisor[s]) ----------
\cs_new_protected:Npn \__luiss_author_supervisor:
  {
    \noindent
    \__luiss_namecolumn:nn { \supervisorlabel } { \academicthesislist{supervisors} }
    \hfill
    \__luiss_namecolumn:nn { \authorlabel }
      { \academicthesis_meta_get:n{candidate}\linebreak\academicthesis_meta_get:n{idnumber} }
  }

\cs_new_protected:Npn \__luiss_author_supervisor_cosupervisor:
  {
    \noindent
    \__luiss_namecolumn:nn { \supervisorlabel }   { \academicthesislist{supervisors} }
    \hfill
    \__luiss_namecolumn:nn { \cosupervisorlabel } { \academicthesislist{cosupervisors} }

    \vspace{0.05\textheight}
    \begin{center}
      \__luiss_namecolumn:nn { \authorlabel }
        { \academicthesis_meta_get:n{candidate}\linebreak\academicthesis_meta_get:n{idnumber} }
    \end{center}
  }

\cs_new_protected:Npn \__luiss_namesblock:
  {
    \noindent
    \makebox[\textwidth][c]{%
      \parbox{\textwidth}{%
        \academicthesis_list_if_empty:nTF {cosupervisors}
          { \__luiss_author_supervisor: }
          { \__luiss_author_supervisor_cosupervisor: }
      }%
    }
  }

\cs_new_protected:Npn \__luiss_academicyear_footer:
  {
    \noindent
    \parbox[c]{\textwidth}{\centering
      \textbf{\thesisstring{AcademicYear}}\par
      \academicthesis_meta_get:n{academicyear}
    }
  }


% =====================================================================
% 4. Front pages: one file per degree, in normal LaTeX syntax
% =====================================================================
% The blocks above stay in expl3; the pages that ASSEMBLE them live in
% separate files read with document catcodes (spaces and blank lines
% behave as usual), one per front page, so each is easy to find and
% debug:
%   academicthesis-luiss-bachelor-master.def   bachelor and master
%   academicthesis-luiss-phd.def               PhD
% They call the blocks through these document-level names:
\cs_new_eq:NN \luiss@logobox        \__luiss_logobox:
\cs_new_eq:NN \luiss@titleblock     \__luiss_titleblock:
\cs_new_eq:NN \luiss@namesblock     \__luiss_namesblock:
\cs_new_eq:NN \luiss@academicyear   \__luiss_academicyear_footer:
\cs_new_eq:NN \luiss@programmeblock \__luiss_programme_block:nnn
\cs_new_eq:NN \luiss@majorline      \__luiss_major_line:
\cs_new_eq:NN \luiss@departmentline \__luiss_department_line:

\academicthesis_input_layout:n
  {
    academicthesis-luiss-
    \bool_if:NTF \g__academicthesis_phd_bool { phd } { bachelor-master }
    .def
  }


% =====================================================================
% 5. Required metadata for LUISS theses
% =====================================================================
% (the degree is already required by the core)
\DeclareThesisRequirement { luiss } \g__academicthesis_bachelor_bool { chair }  { \thesissetup{chair=The~Chair} }
\DeclareThesisRequirement { luiss } \g__academicthesis_master_bool   { chair }  { \thesissetup{chair=The~Chair} }

\DeclareThesisRequirement { luiss } \g__academicthesis_phd_bool { cycle }      { \thesissetup{cycle=XXXVI} }
\DeclareThesisRequirement { luiss } \g__academicthesis_phd_bool { department } { \thesissetup{department=Economics~and~Finance} }
\DeclareThesisRequirement { luiss } \g__academicthesis_phd_bool { phdtitle }   { \thesissetup{phdtitle=Economics} }


% =====================================================================
% 6. Bibliography defaults recommended for LUISS theses
% =====================================================================
\DeclareThesisBibDefaults { luiss } { style = authoryear, backend = biber }

\endinput
